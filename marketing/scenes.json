{
  "version": 1,
  "bundleID": "dev.btuckerc.herdwick",
  "app": "build/DerivedData/Build/Products/Debug-iphonesimulator/Herdwick.app",
  "devices": {
    "iphone": {"simulator": "iPhone 18 Pro Max", "size": [1320, 2868]},
    "ipad": {"simulator": "iPad Pro 13-inch (M5)", "size": [2064, 2752], "args": ["-fontSize", "18"]}
  },
  "defaults": ["-AppleLanguages", "(en)", "-AppleLocale", "en_US", "-appearance", "dark", "-theme.dark", "herdwick-night", "-fontSize", "14", "-inboxView", "agents"],
  "scenes": [
    {"id": "agents-light", "devices": ["iphone"], "args": ["-HerdwickScene", "agents", "-appearance", "light"]},
    {"id": "conversation-ask-light", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p1", "-appearance", "light"]},
    {"id": "loop", "scenario": "loop", "devices": ["iphone"], "args": ["-HerdwickScene", "pane:p5", "-detailLevel", "folded"]},
    {"id": "loop-light", "scenario": "loop", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p5", "-detailLevel", "folded", "-appearance", "light"]},
    {"id": "loop-diff", "scenario": "loop", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p5", "-detailLevel", "folded"], "taps": {"iphone": [[170, 533]], "ipad": [[412, 1008]]}},
    {"id": "loop-catchup", "scenario": "loop", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p5", "-detailLevel", "folded", "-HerdwickSeen", "c17"]},
    {"id": "machines", "devices": ["iphone"], "args": ["-HerdwickScene", "agents", "-inboxView", "machines"]},
    {"id": "tailscale", "devices": ["iphone"], "args": ["-HerdwickScene", "tailscale"]},
    {"id": "theme-day", "devices": ["iphone"], "args": ["-HerdwickScene", "terminal:p2", "-appearance", "light", "-theme.light", "herdwick-day"]},
    {"id": "theme-mocha", "devices": ["iphone"], "args": ["-HerdwickScene", "terminal:p2", "-theme.dark", "catppuccin-mocha"]},
    {"id": "terminal-review", "devices": ["ipad"], "args": ["-HerdwickScene", "terminal:p2", "-HerdwickDraft", "Also cover the empty-range case"]}
  ],
  "preview": {"scenario": "preview", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "agents"]}
}
