{
  "version": 1,
  "bundleID": "dev.btuckerc.herdwick",
  "app": "build/DerivedData/Build/Products/Debug-iphonesimulator/Herdwick.app",
  "devices": {
    "iphone": {"simulator": "iPhone 18 Pro Max", "size": [1320, 2868]},
    "ipad": {"simulator": "iPad Pro 13-inch (M5)", "size": [2064, 2752], "args": ["-fontSize", "18"]}
  },
  "defaults": ["-AppleLanguages", "(en)", "-AppleLocale", "en_US", "-appearance", "dark", "-theme.dark", "herdwick-night", "-fontSize", "14", "-inboxView", "agents"],
  "scenes": [
    {"id": "agents", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "agents"]},
    {"id": "workspaces", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "workspaces"]},
    {"id": "machines", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "agents", "-inboxView", "machines"]},
    {"id": "conversation", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p2"]},
    {"id": "conversation-ask", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p1"]},
    {"id": "subagents", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "pane:p5", "-showWorkingSubagents", "YES"]},
    {"id": "pane-reply", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "terminal:p1", "-HerdwickDraft", "Run the migrations first, then deploy"]},
    {"id": "tailscale", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "tailscale"]},
    {"id": "onboarding", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "onboarding"]},
    {"id": "theme-day", "devices": ["iphone"], "args": ["-HerdwickScene", "terminal:p2", "-appearance", "light", "-theme.light", "herdwick-day"]},
    {"id": "theme-mocha", "devices": ["iphone"], "args": ["-HerdwickScene", "terminal:p2", "-theme.dark", "catppuccin-mocha"]},
    {"id": "theme-gruvbox", "devices": ["iphone"], "args": ["-HerdwickScene", "terminal:p2", "-theme.dark", "gruvbox-dark"]}
  ],
  "preview": {"scenario": "preview", "devices": ["iphone", "ipad"], "args": ["-HerdwickScene", "agents"]}
}
