+// MARK: - Blocking C calls
+
+/// Runs a call into the Go library on a GCD thread. Those calls block (a dial or a LocalAPI
+/// request can take seconds), and Swift's cooperative pool has one thread per core: a few
+/// stuck there stop every other task in the process, timeouts included.
+func offPool(_ work: @escaping @Sendable () -> Void) {
+    DispatchQueue.global(qos: .userInitiated).async(execute: work)
+}
+
+/// `offPool`, awaiting the result.
+func blocking<T: Sendable>(_ work: @escaping @Sendable () throws -> T) async throws -> T {
+    try await withCheckedThrowingContinuation { continuation in
+        offPool { continuation.resume(with: Result { try work() }) }
+    }
+}
+
+/// `offPool`, awaiting the result.
+func blocking<T: Sendable>(_ work: @escaping @Sendable () -> T) async -> T {
+    await withCheckedContinuation { continuation in
+        offPool { continuation.resume(returning: work()) }
+    }
+}
