+//export TsnetRebind
+func TsnetRebind(sd C.int) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	lc, err := s.s.LocalClient()
+	if err != nil {
+		return s.recErr(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	if err := lc.DebugAction(ctx, "rebind"); err != nil {
+		return s.recErr(err)
+	}
+	return s.recErr(lc.DebugAction(ctx, "restun"))
+}
+
+//export TsnetPing
+func TsnetPing(sd C.int, addr *C.char, timeoutMillis C.int) C.int {
+	s := getServer(sd)
+	if s == nil {
+		return C.EBADF
+	}
+	ip, err := netip.ParseAddr(C.GoString(addr))
+	if err != nil {
+		return s.recErr(err)
+	}
+	lc, err := s.s.LocalClient()
+	if err != nil {
+		return s.recErr(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeoutMillis)*time.Millisecond)
+	defer cancel()
+	res, err := lc.Ping(ctx, ip, tailcfg.PingDisco)
+	if err != nil {
+		return s.recErr(err)
+	}
+	if res.Err != "" {
+		return s.recErr(errors.New(res.Err))
+	}
+	return 0
+}
